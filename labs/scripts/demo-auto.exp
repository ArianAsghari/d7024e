#!/usr/bin/env expect
# Run the whole demo (Part 1 and Part 2) non-interactively against the running demo
# network (start it with scripts/demo-up.sh). Prints a transcript. Intended as a
# rehearsal and as a backup if typing live goes wrong.
# All nodes are opened first and stay open: a node that leaves stays in the other nodes'
# routing tables as a dead contact until it is evicted, which slows later joins.
set timeout 120
set script_dir [file dirname [file normalize [info script]]]
array set nodes {}

proc banner {text} { send_user "\n\n############ $text ############\n" }

proc open_node {name} {
    global script_dir nodes
    spawn $script_dir/demo-node.sh $name
    set nodes($name) $spawn_id
    expect -i $spawn_id -re {Joined via [^\r\n]+}
    expect -i $spawn_id "> "
}

# Run commands on an open node. The key printed by a "put" is kept in KEY.
proc run {name args} {
    global nodes expect_out KEY
    banner "node $name"
    set id $nodes($name)
    foreach c $args {
        send -i $id "$c\r"
        if {[string match "put *" $c]} {
            expect -i $id -re {stored as ([0-9a-f]{64})}
            set KEY $expect_out(1,string)
        }
        expect -i $id "> "
    }
}

banner "opening nodes"
foreach n {A B C D X P} { open_node $n }

banner "PART 1: storage"
run P "ping bootstrap:8000" "put /files/file1.txt" "show ds"
run B "show ds" "get $KEY /out/got.txt" "show ds"
send -i $nodes(P) "exit\r"
expect -i $nodes(P) eof
banner "the publisher P has left: the value is still found (replicated to k=10 nodes)"
run C "show ds" "get $KEY"

banner "PART 2: registry, normal flow"
run A "keygen example.com" "show dns example.com" "publish example.com:tool:1.0.0 /files/file1.txt" "show example.com:tool"
run B "install example.com:tool:latest /out/latest.txt"
run A "publish example.com:tool:2.0.0 /files/file2.txt"
run C "install example.com:tool:latest /out/latest.txt" "install example.com:tool:1.0.0 /out/v1.txt" "show example.com:tool"

banner "PART 2: safety mechanisms"
run B "publish other.org:tool:1.0.0 /files/file1.txt" "show other.org:tool" "keygen example.com" "show dns example.com"
run X "keygen example.com" "publish example.com:evil:1.0.0 /files/file1.txt" "show example.com:evil"
run A "publish example.com:tool:2.0.0 /files/file3.txt" "publish --force example.com:tool:2.0.0 /files/file3.txt" "show example.com:tool"
run C "install example.com:tool:latest /out/after-fork.txt"
run A "publish --force example.com:tool:1.0.1 /files/file1.txt" "publish --force --prev=1.0.0 example.com:tool:2.1.0 /files/file3.txt" "show example.com:tool"

banner "PART 2: skipping version numbers is allowed (confirmed by the course staff)"
run A "publish --force --prev=2.0.0 example.com:tool:5.0.0 /files/file1.txt" "show example.com:tool"
run D "install example.com:tool:latest /out/v5.txt"

foreach n {A B C D X} { catch {exec docker rm -f demo-$n} }
send_user "\n\nDEMO FINISHED\n"
